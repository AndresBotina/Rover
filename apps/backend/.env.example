# =============================================================================
# Plantilla de configuración del backend de Rover (HU-0.8).
#
# Uso en LOCAL:   cp .env.example .env   y ajusta lo que necesites.
#   El .env real está git-ignorado y NUNCA se commitea.
# En PRODUCCIÓN (Render) NO hay archivo .env: las variables se configuran en
#   el panel del servicio (Environment). ROVER_ENV ya lo fija render.yaml.
#
# Todas las variables llevan el prefijo ROVER_ (ver app/core/config.py).
# Los valores de este archivo son EJEMPLOS/placeholders: jamás pongas aquí un
# valor real de un secreto.
# =============================================================================

# --- App (no sensible; con defaults sensatos, puedes omitirlas) --------------

# Nombre de marca visible al usuario.
ROVER_APP_NAME=Rover

# Ambiente: local | test | production. Cualquier otro valor impide arrancar.
ROVER_ENV=local

# Versión reportada por /v1/health. Normalmente NO se define: la fuente de
# verdad es app.__version__ (este override existe solo para casos puntuales).
# ROVER_VERSION=0.1.0

# --- Base de datos / Supabase (Épica 1) — SECRETOS ---------------------------
# Descomenta cuando exista el proyecto de Supabase. Valores reales SOLO en tu
# .env local o en Render → Environment. En producción serán OBLIGATORIAS
# (la app no arranca si faltan: ver _REQUIRED_IN_PRODUCTION en config.py).

# URL del proyecto de Supabase (SECRETO).
# ROVER_SUPABASE_URL=https://tu-proyecto.supabase.co

# Anon/public key de Supabase (SECRETO).
# ROVER_SUPABASE_ANON_KEY=coloca-aqui-tu-anon-key

# Service-role key de Supabase (SECRETO — solo backend, jamás en clientes).
# ROVER_SUPABASE_SERVICE_ROLE_KEY=coloca-aqui-tu-service-role-key

# Cadena de conexión a Postgres (SECRETO: incluye la contraseña).
# ROVER_DATABASE_URL=postgresql://usuario:password@host:5432/rover

# --- LLM (Épica 1, más adelante) — SECRETOS ----------------------------------

# API key del proveedor del LLM (SECRETO).
# ROVER_LLM_API_KEY=coloca-aqui-tu-api-key
