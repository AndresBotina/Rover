# =============================================================================
# Plantilla de configuración del backend de Rover (HU-0.8).
#
# Uso en LOCAL:   cp .env.example .env   y ajusta lo que necesites.
#   El .env real está git-ignorado y NUNCA se commitea.
# En PRODUCCIÓN (Render) NO hay archivo .env: las variables se configuran en
#   el panel del servicio (Environment). ROVER_ENV ya lo fija render.yaml.
#
# Todas las variables llevan el prefijo ROVER_ (ver app/core/config.py).
# Los valores de este archivo son EJEMPLOS/placeholders: jamás pongas aquí un
# valor real de un secreto.
# =============================================================================

# --- App (no sensible; con defaults sensatos, puedes omitirlas) --------------

# Nombre de marca visible al usuario.
ROVER_APP_NAME=Rover

# Ambiente: local | test | production. Cualquier otro valor impide arrancar.
ROVER_ENV=local

# Versión reportada por /v1/health. Normalmente NO se define: la fuente de
# verdad es app.__version__ (este override existe solo para casos puntuales).
# ROVER_VERSION=0.1.0

# Documentación interactiva (/docs, /redoc, /openapi.json). Si NO se define,
# decide el ambiente: activa fuera de producción, APAGADA en producción (el
# esquema es el mapa completo de la API y no hace falta publicarlo). Definirla
# fuerza el valor — p. ej. true para depurar en producción (HU-1.9).
# ROVER_ENABLE_DOCS=true

# --- Rate limiting (HU-1.7; no sensible, con defaults sensatos) --------------
# Límites en "N peticiones por ventana". El algoritmo y el porqué de cada valor
# están en app/core/rate_limit.py y app/core/config.py.

# Interruptor general. Se apaga para desactivar los límites en un incidente sin
# tener que desplegar.
# ROVER_RATE_LIMIT_ENABLED=true

# GLOBAL, por IP: protección base de toda la API (120/min ≈ 2 req/s).
# ROVER_RATE_LIMIT_DEFAULT_LIMIT=120
# ROVER_RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60

# AUTH, por IP: /v1/auth/login y /v1/auth/register. Mucho más estricto — es
# donde se adivinan contraseñas y se crean cuentas en masa.
# ROVER_RATE_LIMIT_AUTH_LIMIT=10
# ROVER_RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# USUARIO, por id del token: la cuota de la cuenta autenticada.
# ROVER_RATE_LIMIT_USER_LIMIT=60
# ROVER_RATE_LIMIT_USER_WINDOW_SECONDS=60

# Multiplicador de la cuota de usuario para los planes de pago. 1.0 = hoy free
# y pro valen lo mismo; es el enganche de la Épica 5 (monetización).
# ROVER_RATE_LIMIT_PRO_MULTIPLIER=1.0

# Saltos de proxy DE CONFIANZA delante de la app, para leer la IP real de
# X-Forwarded-For sin que el cliente pueda falsificarla. Render pone
# exactamente 1 (su edge). Con un CDN delante serían 2. Con 0 la cabecera se
# IGNORA y se usa el peer TCP (exposición directa, p. ej. en local).
# ROVER_RATE_LIMIT_TRUSTED_PROXIES=1

# --- Base de datos / Supabase (Épica 1) — SECRETOS ---------------------------
# Valores reales SOLO en tu .env local o en Render → Environment. En producción
# son OBLIGATORIAS (la app no arranca si faltan: ver _REQUIRED_IN_PRODUCTION
# en config.py).

# Conexión a Supabase Postgres (SECRETO: incluye la contraseña).
# RECOMENDADO (local y producción): la URL del TRANSACTION POOLER (Supavisor,
# puerto 6543) — la conexión directa resuelve a IPv6 y ni local ni Render
# tienen salida IPv6. El código detecta el pooler por la URL y desactiva los
# prepared statements de asyncpg automáticamente (ver app/core/database.py).
# Va TAL CUAL la entrega Supabase (prefijo postgresql://): el driver async
# (postgresql+asyncpg://) lo añade el código — NO la guardes transformada.
# OBLIGATORIA en producción (HU-1.1).
ROVER_DATABASE_URL=postgresql://postgres.TU-PROYECTO:TU-PASSWORD@aws-1-TU-REGION.pooler.supabase.com:6543/postgres

# URL del proyecto de Supabase. No es un secreto en sí (aparece en cualquier
# request al API desde un cliente), pero SÍ es OBLIGATORIA en producción: sin
# ella no hay a quién llamar (HU-1.3, registro/login vía Supabase Auth).
ROVER_SUPABASE_URL=https://tu-proyecto.supabase.co

# Anon/public key de Supabase (SECRETO por convención del proyecto — SecretStr
# para no filtrarla en logs/repr; Supabase la considera segura para clientes).
# Es la que usa el REGISTRO (HU-1.3) y el LOGIN (HU-1.4): permisos de cliente
# público, sin privilegios elevados. OBLIGATORIA en producción.
ROVER_SUPABASE_ANON_KEY=coloca-aqui-tu-anon-key

# Service-role key de Supabase (SECRETO — SOLO BACKEND, JAMÁS en clientes web
# ni móvil, JAMÁS en logs). Permisos ADMINISTRATIVOS totales: se salta Row
# Level Security. Queda configurada para operaciones administrativas futuras;
# el registro/login (HU-1.3/1.4) NO la usa. OBLIGATORIA en producción.
ROVER_SUPABASE_SERVICE_ROLE_KEY=coloca-aqui-tu-service-role-key

# --- LLM (Épica 1, más adelante) — SECRETOS ----------------------------------

# API key del proveedor del LLM (SECRETO).
# ROVER_LLM_API_KEY=coloca-aqui-tu-api-key
