{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "Config base estricta del monorepo. Los workspaces JS/TS la heredan vía extends.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "esModuleInterop": true,
    // @rover/shared se consume como FUENTE y sus tests corren con node --test
    // directo sobre .ts (type stripping), que exige la extensión .ts en los
    // imports relativos; esta opción permite escribirla (requiere noEmit).
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "noEmit": true,

    // --- Estrictez ---
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true
  }
}
